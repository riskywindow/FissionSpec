+    def test_incomplete_or_malformed_fission_reply_cannot_fill_version_zero(self):
+        req = _FakeReq()
+        req.spec_cnt = 3
+        scheduler = _FakeScheduler(_FakeBatch([req]))
+        scheduler.req_to_draft_token[req.rid][(3, 0)] = None
+        missing = _Request(
+            request_id=req.rid,
+            spec_cnt=3,
+            fission_version=None,
+            action=_Action.DRAFT,
+            draft_token_ids=[11],
+            draft_logprobs=[0.1],
+            target_send_time=-1.0,
+        )
+        malformed = _Request(
+            request_id=req.rid,
+            spec_cnt=3,
+            fission_version=-1,
+            action=_Action.DRAFT,
+            draft_token_ids=[12],
+            draft_logprobs=[0.2],
+            target_send_time=-1.0,
+        )
+        complete = _Request(
+            request_id=req.rid,
+            spec_cnt=3,
+            fission_version=0,
+            action=_Action.DRAFT,
+            draft_token_ids=[13],
+            draft_logprobs=[0.3],
+            target_send_time=-1.0,
+        )
+
+        TARGET.SchedulerSpectreTargetMixin._store_messages(
+            scheduler, [missing, malformed]
+        )
+        self.assertIsNone(scheduler.req_to_draft_token[req.rid][(3, 0)])
+        TARGET.SchedulerSpectreTargetMixin._store_messages(scheduler, [complete])
+        self.assertEqual(
+            scheduler.req_to_draft_token[req.rid][(3, 0)],
+            ([13], [0.3]),
+        )
+
