+    def test_wire_key_requires_complete_nonnegative_integer_identity(self):
+        self.assertEqual(
+            fission_wire_key(3, None, require_version=False),
+            (3, 0),
+        )
+        self.assertIsNone(fission_wire_key(3, None, require_version=True))
+        for spec_cnt, version in (
+            (True, 0),
+            (-1, 0),
+            (3, False),
+            (3, -1),
+            (3, "1"),
+        ):
+            self.assertIsNone(
+                fission_wire_key(spec_cnt, version, require_version=True)
+            )
+
+    def test_versioned_control_requires_an_exact_complete_key(self):
+        current = (3, 7)
+        self.assertTrue(
+            fission_control_matches(
+                current, 3, 7, require_identity=True
+            )
+        )
+        for spec_cnt, version in (
+            (3, None),
+            (3, 6),
+            (3, 8),
+            (2, 7),
+            (4, 7),
+            (3, -1),
+        ):
+            self.assertFalse(
+                fission_control_matches(
+                    current,
+                    spec_cnt,
+                    version,
+                    require_identity=True,
+                )
+            )
+        self.assertTrue(
+            fission_control_matches(
+                current, 999, None, require_identity=False
+            )
+        )
