@@ -47,6 +47,55 @@ def fission_enabled(environ: Optional[dict[str, str]] = None) -> bool:
     }
 
 
+def fission_wire_key(
+    spec_cnt: object,
+    fission_version: object,
+    *,
+    require_version: bool,
+) -> Optional[tuple[int, int]]:
+    """Return a validated wire key, or ``None`` for an incomplete identity.
+
+    Legacy SPECTRE messages omit ``fission_version`` and remain decodable while
+    fission is disabled. Once either endpoint requires fission identity, a
+    missing, boolean, negative, or non-integer component fails closed.
+    """
+
+    if (
+        isinstance(spec_cnt, bool)
+        or not isinstance(spec_cnt, int)
+        or spec_cnt < 0
+    ):
+        return None
+    if fission_version is None:
+        return None if require_version else (spec_cnt, 0)
+    if (
+        isinstance(fission_version, bool)
+        or not isinstance(fission_version, int)
+        or fission_version < 0
+    ):
+        return None
+    return (spec_cnt, fission_version)
+
+
+def fission_control_matches(
+    current_key: tuple[int, int],
+    spec_cnt: object,
+    fission_version: object,
+    *,
+    require_identity: bool,
+) -> bool:
+    """Return whether a FINISH/ABORT message may mutate the current state."""
+
+    if not require_identity:
+        return True
+    incoming_key = fission_wire_key(
+        spec_cnt,
+        fission_version,
+        require_version=True,
+    )
+    return incoming_key == current_key
+
+
 @dataclass(frozen=True, order=True)
 class FissionKey:
     request_id: str
