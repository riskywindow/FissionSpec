@@ -0,0 +1,63 @@
+import importlib.util
+from pathlib import Path
+import sys
+from types import ModuleType
+import unittest
+
+_ROOT = Path(__file__).resolve().parents[2]
+_SOURCE = _ROOT / "python/sglang/srt/speculative/spectre/spectre_protocol.py"
+
+
+class _SamplingParams:
+    def __init__(self, **values):
+        self.__dict__.update(values)
+
+
+sampling_module = ModuleType("sglang.srt.sampling.sampling_params")
+sampling_module.SamplingParams = _SamplingParams
+sys.modules[sampling_module.__name__] = sampling_module
+
+_SPEC = importlib.util.spec_from_file_location("spectre_protocol_test", _SOURCE)
+assert _SPEC is not None and _SPEC.loader is not None
+PROTOCOL = importlib.util.module_from_spec(_SPEC)
+sys.modules[_SPEC.name] = PROTOCOL
+_SPEC.loader.exec_module(PROTOCOL)
+
+
+class TestFissionWireIdentity(unittest.TestCase):
+    def test_legacy_message_omits_optional_version(self):
+        message = PROTOCOL.SpectreRequest(request_id="r0", spec_cnt=4)
+        wire = message.to_dict()
+        self.assertNotIn("fission_version", wire)
+        decoded = PROTOCOL.SpectreRequest.from_dict(wire)
+        self.assertIsNone(decoded.fission_version)
+
+    def test_fission_version_round_trips(self):
+        message = PROTOCOL.SpectreRequest(
+            request_id="r0",
+            spec_cnt=4,
+            fission_version=12,
+            action=PROTOCOL.SpectreAction.DRAFT,
+        )
+        wire = message.to_dict()
+        decoded = PROTOCOL.SpectreRequest.from_dict(wire)
+        self.assertEqual(
+            (decoded.request_id, decoded.spec_cnt, decoded.fission_version),
+            ("r0", 4, 12),
+        )
+        self.assertEqual(decoded.action, PROTOCOL.SpectreAction.DRAFT)
+
+    def test_unknown_fields_remain_forward_compatible(self):
+        decoded = PROTOCOL.SpectreRequest.from_dict(
+            {
+                "request_id": "r0",
+                "spec_cnt": 4,
+                "fission_version": 12,
+                "future_field": "ignored",
+            }
+        )
+        self.assertEqual(decoded.fission_version, 12)
+
+
+if __name__ == "__main__":
+    unittest.main()
