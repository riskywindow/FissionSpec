diff --git a/python/sglang/srt/speculative/spectre/fission_state.py b/python/sglang/srt/speculative/spectre/fission_state.py
new file mode 100644
index 000000000..898b02c0b
--- /dev/null
+++ b/python/sglang/srt/speculative/spectre/fission_state.py
@@ -0,0 +1,287 @@
+"""CPU-only request identity and lane state for SPECTRE fission mode.
+
+This module deliberately has no torch, CUDA, or SGLang scheduler imports.  The
+target scheduler owns the request and KV descriptors; this table only decides
+whether an asynchronous event is allowed to mutate that ownership.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, replace
+from enum import Enum
+import os
+from typing import Dict, Iterable, Optional
+
+
+class FissionLane(str, Enum):
+    READY_HIT = "ready_hit"
+    VERIFYING = "verifying"
+    RECOVERING = "recovering"
+    READY_BACKUP = "ready_backup"
+    BYPASS = "bypass"
+    FINISHED = "finished"
+    CANCELLED = "cancelled"
+
+
+class FissionOutcome(str, Enum):
+    HIT = "hit"
+    RECOVERING = "recovering"
+    FINISHED = "finished"
+
+
+class FissionEventResult(str, Enum):
+    APPLIED = "applied"
+    DUPLICATE = "duplicate"
+    STALE = "stale"
+    INVALID = "invalid"
+
+
+def fission_enabled(environ: Optional[dict[str, str]] = None) -> bool:
+    """Return the opt-in flag; absence and malformed values fail off."""
+
+    source = os.environ if environ is None else environ
+    return source.get("SGLANG_SPECTRE_FISSION", "0").lower() in {
+        "1",
+        "true",
+        "yes",
+    }
+
+
+@dataclass(frozen=True, order=True)
+class FissionKey:
+    request_id: str
+    spec_cnt: int
+    fission_version: int
+
+
+@dataclass(frozen=True)
+class FissionOutcomeEvent:
+    key: FissionKey
+    outcome: FissionOutcome
+    next_spec_cnt: int
+
+
+@dataclass(frozen=True)
+class FissionRecord:
+    key: FissionKey
+    lane: FissionLane
+    ready_since_ns: int
+    recovery_started_ns: Optional[int] = None
+    deadline_ns: Optional[int] = None
+    stale_events: int = 0
+    duplicate_events: int = 0
+
+    def recovery_age_ns(self, now_ns: int) -> int:
+        if self.recovery_started_ns is None:
+            return 0
+        return max(0, now_ns - self.recovery_started_ns)
+
+
+class FissionStateTable:
+    """Version-fenced lane transitions for one target scheduler process."""
+
+    def __init__(self) -> None:
+        self._records: Dict[str, FissionRecord] = {}
+
+    def ensure(
+        self,
+        request_id: str,
+        spec_cnt: int,
+        now_ns: int,
+        *,
+        deadline_ns: Optional[int] = None,
+    ) -> FissionRecord:
+        record = self._records.get(request_id)
+        if record is None:
+            record = FissionRecord(
+                key=FissionKey(request_id, spec_cnt, 0),
+                lane=FissionLane.READY_HIT,
+                ready_since_ns=now_ns,
+                deadline_ns=deadline_ns,
+            )
+            self._records[request_id] = record
+        return record
+
+    def get(self, request_id: str) -> Optional[FissionRecord]:
+        return self._records.get(request_id)
+
+    def records(self) -> Iterable[FissionRecord]:
+        return tuple(self._records.values())
+
+    def begin_verify(
+        self, request_id: str
+    ) -> tuple[FissionEventResult, Optional[FissionKey]]:
+        record = self._records.get(request_id)
+        if record is None:
+            return FissionEventResult.INVALID, None
+        if record.lane == FissionLane.VERIFYING:
+            duplicate = replace(record, duplicate_events=record.duplicate_events + 1)
+            self._records[request_id] = duplicate
+            return FissionEventResult.DUPLICATE, record.key
+        if record.lane not in {
+            FissionLane.READY_HIT,
+            FissionLane.READY_BACKUP,
+            FissionLane.BYPASS,
+        }:
+            return FissionEventResult.INVALID, record.key
+        self._records[request_id] = replace(record, lane=FissionLane.VERIFYING)
+        return FissionEventResult.APPLIED, record.key
+
+    def post_verify(
+        self,
+        key: FissionKey,
+        outcome: FissionOutcome,
+        next_spec_cnt: int,
+        now_ns: int,
+    ) -> tuple[FissionEventResult, Optional[FissionKey]]:
+        record = self._records.get(key.request_id)
+        if record is None:
+            return FissionEventResult.STALE, None
+        if record.key != key:
+            self._records[key.request_id] = replace(
+                record, stale_events=record.stale_events + 1
+            )
+            return FissionEventResult.STALE, record.key
+        if record.lane != FissionLane.VERIFYING:
+            self._records[key.request_id] = replace(
+                record, duplicate_events=record.duplicate_events + 1
+            )
+            return FissionEventResult.DUPLICATE, record.key
+
+        next_key = FissionKey(
+            key.request_id,
+            next_spec_cnt,
+            key.fission_version + 1,
+        )
+        if outcome == FissionOutcome.HIT:
+            next_record = replace(
+                record,
+                key=next_key,
+                lane=FissionLane.READY_HIT,
+                ready_since_ns=now_ns,
+                recovery_started_ns=None,
+            )
+        elif outcome == FissionOutcome.RECOVERING:
+            next_record = replace(
+                record,
+                key=next_key,
+                lane=FissionLane.RECOVERING,
+                recovery_started_ns=now_ns,
+            )
+        elif outcome == FissionOutcome.FINISHED:
+            next_record = replace(
+                record,
+                key=next_key,
+                lane=FissionLane.FINISHED,
+                recovery_started_ns=None,
+            )
+        else:
+            return FissionEventResult.INVALID, record.key
+        self._records[key.request_id] = next_record
+        return FissionEventResult.APPLIED, next_key
+
+    def complete_recovery(self, key: FissionKey, now_ns: int) -> FissionEventResult:
+        record = self._records.get(key.request_id)
+        if record is None:
+            return FissionEventResult.STALE
+        if record.key != key:
+            self._records[key.request_id] = replace(
+                record, stale_events=record.stale_events + 1
+            )
+            return FissionEventResult.STALE
+        if record.lane == FissionLane.READY_BACKUP:
+            self._records[key.request_id] = replace(
+                record, duplicate_events=record.duplicate_events + 1
+            )
+            return FissionEventResult.DUPLICATE
+        if record.lane != FissionLane.RECOVERING:
+            return FissionEventResult.INVALID
+        self._records[key.request_id] = replace(
+            record,
+            lane=FissionLane.READY_BACKUP,
+            ready_since_ns=now_ns,
+            recovery_started_ns=None,
+        )
+        return FissionEventResult.APPLIED
+
+    def force_bypass(self, request_id: str, now_ns: int) -> FissionEventResult:
+        record = self._records.get(request_id)
+        if record is None:
+            return FissionEventResult.INVALID
+        if record.lane in {FissionLane.FINISHED, FissionLane.CANCELLED}:
+            return FissionEventResult.INVALID
+        if record.lane == FissionLane.BYPASS:
+            self._records[request_id] = replace(
+                record, duplicate_events=record.duplicate_events + 1
+            )
+            return FissionEventResult.DUPLICATE
+        self._records[request_id] = replace(
+            record,
+            key=FissionKey(
+                request_id,
+                record.key.spec_cnt,
+                record.key.fission_version + 1,
+            ),
+            lane=FissionLane.BYPASS,
+            ready_since_ns=now_ns,
+            recovery_started_ns=None,
+        )
+        return FissionEventResult.APPLIED
+
+    def expire(self, now_ns: int, recovery_timeout_ns: int) -> tuple[FissionKey, ...]:
+        expired = []
+        for record in tuple(self._records.values()):
+            if record.lane != FissionLane.RECOVERING:
+                continue
+            timed_out = record.recovery_age_ns(now_ns) >= recovery_timeout_ns
+            deadline_missed = (
+                record.deadline_ns is not None and now_ns >= record.deadline_ns
+            )
+            if timed_out or deadline_missed:
+                expired.append(record.key)
+                self.force_bypass(record.key.request_id, now_ns)
+        return tuple(expired)
+
+    def finish(self, request_id: str, spec_cnt: int) -> FissionEventResult:
+        record = self._records.get(request_id)
+        if record is None:
+            return FissionEventResult.INVALID
+        if record.lane == FissionLane.FINISHED:
+            return FissionEventResult.DUPLICATE
+        self._records[request_id] = replace(
+            record,
+            key=FissionKey(
+                request_id,
+                spec_cnt,
+                record.key.fission_version + 1,
+            ),
+            lane=FissionLane.FINISHED,
+            recovery_started_ns=None,
+        )
+        return FissionEventResult.APPLIED
+
+    def cancel(self, request_id: str, spec_cnt: int) -> FissionEventResult:
+        record = self._records.get(request_id)
+        if record is None:
+            return FissionEventResult.INVALID
+        if record.lane == FissionLane.CANCELLED:
+            return FissionEventResult.DUPLICATE
+        self._records[request_id] = replace(
+            record,
+            key=FissionKey(
+                request_id,
+                spec_cnt,
+                record.key.fission_version + 1,
+            ),
+            lane=FissionLane.CANCELLED,
+            recovery_started_ns=None,
+        )
+        return FissionEventResult.APPLIED
+
+    def remove_terminal(self, request_id: str) -> None:
+        record = self._records.get(request_id)
+        if record is not None and record.lane in {
+            FissionLane.FINISHED,
+            FissionLane.CANCELLED,
+        }:
+            del self._records[request_id]
