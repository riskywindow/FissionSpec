@@ -0,0 +1,138 @@
+import itertools
+import importlib.util
+from pathlib import Path
+import sys
+import unittest
+
+_SOURCE = (
+    Path(__file__).resolve().parents[2]
+    / "python/sglang/srt/speculative/spectre/fission_state.py"
+)
+_SPEC = importlib.util.spec_from_file_location("spectre_fission_state", _SOURCE)
+assert _SPEC is not None and _SPEC.loader is not None
+_MODULE = importlib.util.module_from_spec(_SPEC)
+sys.modules[_SPEC.name] = _MODULE
+_SPEC.loader.exec_module(_MODULE)
+
+FissionEventResult = _MODULE.FissionEventResult
+FissionKey = _MODULE.FissionKey
+FissionLane = _MODULE.FissionLane
+FissionOutcome = _MODULE.FissionOutcome
+FissionStateTable = _MODULE.FissionStateTable
+fission_enabled = _MODULE.fission_enabled
+
+
+class TestFissionStateTable(unittest.TestCase):
+    def test_feature_flag_is_off_by_default(self):
+        self.assertFalse(fission_enabled({}))
+        self.assertFalse(fission_enabled({"SGLANG_SPECTRE_FISSION": "garbage"}))
+        self.assertTrue(fission_enabled({"SGLANG_SPECTRE_FISSION": "true"}))
+
+    def _verifying(
+        self, rid: str = "r0", spec_cnt: int = 7
+    ) -> tuple[FissionStateTable, FissionKey]:
+        table = FissionStateTable()
+        table.ensure(rid, spec_cnt, 10)
+        result, key = table.begin_verify(rid)
+        self.assertEqual(result, FissionEventResult.APPLIED)
+        self.assertIsNotNone(key)
+        return table, key
+
+    def test_hit_advances_full_identity(self):
+        table, key = self._verifying()
+        result, next_key = table.post_verify(key, FissionOutcome.HIT, 8, 20)
+        self.assertEqual(result, FissionEventResult.APPLIED)
+        self.assertEqual(next_key, FissionKey("r0", 8, 1))
+        self.assertEqual(table.get("r0").lane, FissionLane.READY_HIT)
+
+    def test_recovery_is_version_fenced_and_idempotent(self):
+        table, key = self._verifying()
+        _, recovery_key = table.post_verify(key, FissionOutcome.RECOVERING, 8, 20)
+        self.assertEqual(table.complete_recovery(key, 30), FissionEventResult.STALE)
+        self.assertEqual(
+            table.complete_recovery(recovery_key, 30),
+            FissionEventResult.APPLIED,
+        )
+        self.assertEqual(
+            table.complete_recovery(recovery_key, 31),
+            FissionEventResult.DUPLICATE,
+        )
+        record = table.get("r0")
+        self.assertEqual(record.lane, FissionLane.READY_BACKUP)
+        self.assertEqual(record.stale_events, 1)
+        self.assertEqual(record.duplicate_events, 1)
+
+    def test_cancel_fences_inflight_recovery(self):
+        table, key = self._verifying()
+        _, recovery_key = table.post_verify(key, FissionOutcome.RECOVERING, 8, 20)
+        self.assertEqual(table.cancel("r0", 8), FissionEventResult.APPLIED)
+        self.assertEqual(
+            table.complete_recovery(recovery_key, 30),
+            FissionEventResult.STALE,
+        )
+        self.assertEqual(table.get("r0").lane, FissionLane.CANCELLED)
+
+    def test_timeout_and_deadline_fail_to_bypass(self):
+        timeout_table, timeout_key = self._verifying("timeout")
+        timeout_table.post_verify(timeout_key, FissionOutcome.RECOVERING, 8, 20)
+        self.assertEqual(timeout_table.expire(119, 100), ())
+        self.assertEqual(
+            timeout_table.expire(120, 100),
+            (FissionKey("timeout", 8, 1),),
+        )
+        self.assertEqual(timeout_table.get("timeout").lane, FissionLane.BYPASS)
+
+        deadline_table = FissionStateTable()
+        deadline_table.ensure("deadline", 2, 10, deadline_ns=50)
+        _, deadline_key = deadline_table.begin_verify("deadline")
+        deadline_table.post_verify(deadline_key, FissionOutcome.RECOVERING, 3, 20)
+        deadline_table.expire(50, 10_000)
+        self.assertEqual(
+            deadline_table.get("deadline").lane,
+            FissionLane.BYPASS,
+        )
+
+    def test_duplicate_post_verify_cannot_advance_twice(self):
