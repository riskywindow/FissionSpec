diff --git a/test/srt/test_spectre_fission_scheduler.py b/test/srt/test_spectre_fission_scheduler.py
new file mode 100644
index 000000000..6fc17eab2
--- /dev/null
+++ b/test/srt/test_spectre_fission_scheduler.py
@@ -0,0 +1,287 @@
+from collections import defaultdict
+import importlib.util
+from pathlib import Path
+import sys
+from types import ModuleType, SimpleNamespace
+import unittest
+
+_ROOT = Path(__file__).resolve().parents[2]
+_FISSION_SOURCE = _ROOT / "python/sglang/srt/speculative/spectre/fission_state.py"
+_TARGET_SOURCE = (
+    _ROOT
+    / "python/sglang/srt/speculative/spectre/verifier"
+    / "spectre_target_scheduler_mixin.py"
+)
+
+
+def _load(name, source):
+    spec = importlib.util.spec_from_file_location(name, source)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def _stub(name, **members):
+    module = ModuleType(name)
+    for key, value in members.items():
+        setattr(module, key, value)
+    sys.modules[name] = module
+    return module
+
+
+class _DynamicGradMode:
+    def __call__(self, function):
+        return function
+
+
+class _Action:
+    DRAFT = "draft"
+    FINISH = "finish"
+    ABORT = "abort"
+    REJECT = "reject"
+
+
+class _Request:
+    def __init__(self, **values):
+        self.__dict__.update(values)
+
+
+class _SpecType:
+    DRAFT_REQUEST = "draft_request"
+
+
+class _ForwardMode:
+    DECODE = "decode"
+    EXTEND = "extend"
+
+
+class _FakeReq:
+    def __init__(self, rid="r0"):
+        self.rid = rid
+        self.spec_cnt = 0
+        self.fission_version = 0
+        self.req_pool_idx = 37
+        self.cur_drafts = []
+        self.output_ids = [101]
+        self.origin_input_ids = [100]
+        self.is_retracted = False
+        self._finished = False
+
+    def finished(self):
+        return self._finished
+
+
+class _FakeBatch:
+    def __init__(self, reqs):
+        self.reqs = list(reqs)
+        self.forward_mode = _ForwardMode.DECODE
+        self.fission_keys = {}
+        self.fission_outcomes = []
+        self.filter_calls = []
+
+    def batch_size(self):
+        return len(self.reqs)
+
+    def is_empty(self):
+        return not self.reqs
+
+    def filter_batch(self, *, keep_indices, v1_spec_info_filtered):
+        self.filter_calls.append((tuple(keep_indices), v1_spec_info_filtered))
+        self.reqs = [self.reqs[index] for index in keep_indices]
+
+    def merge_batch(self, other):
+        self.reqs.extend(other.reqs)
+
+
+def _load_target_module():
+    fission = _load(
+        "sglang.srt.speculative.spectre.fission_state",
+        _FISSION_SOURCE,
+    )
+    _stub(
+        "sglang.srt.environ",
+        envs=SimpleNamespace(
+            SGLANG_ENABLE_STRICT_MEM_CHECK_DURING_BUSY=SimpleNamespace(
+                get=lambda: False
+            )
+        ),
+    )
+    _stub(
+        "sglang.srt.managers.schedule_batch",
+        Req=_FakeReq,
+        ScheduleBatch=_FakeBatch,
+    )
+    _stub(
+        "sglang.srt.model_executor.forward_batch_info",
+        ForwardMode=_ForwardMode,
+    )
+    _stub(
+        "sglang.srt.speculative.spectre.spectre_protocol",
+        SpectreAction=_Action,
+        SpectreRequest=_Request,
+        SpecType=_SpecType,
+        is_health_check_req=lambda req: False,
+    )
+    _stub(
+        "sglang.srt.utils",
+        DynamicGradMode=_DynamicGradMode,
+        broadcast_pyobj=lambda messages, *_args, **_kwargs: messages,
+    )
+    worker = _stub("sglang.srt.speculative.spectre.verifier.spectre_worker")
+
+    def apply_drafts(req, verified_token, drafts, *, skip_d0):
+        del verified_token
+        assert not skip_d0
+        req.cur_drafts = list(drafts[0])
+
+    worker._apply_drafts_to_req = apply_drafts
+    target = _load("spectre_target_scheduler_mixin_test", _TARGET_SOURCE)
+    return fission, target
+
+
+FISSION, TARGET = _load_target_module()
+
+
+class _FakeScheduler(TARGET.SchedulerSpectreTargetMixin):
+    def __init__(self, batch):
+        self._spectre_fission_enabled = True
+        self._fission_state = FISSION.FissionStateTable()
+        self._fission_parked = {}
+        self._fission_recovery_timeout_ns = 1_000_000_000_000
+        self.req_to_draft_token = defaultdict(dict)
+        self.server_args = SimpleNamespace(
+            speculative_num_steps=4,
+            cuda_graph_bs=[1, 2, 4, 8],
+        )
+        self.running_batch = batch
+        self.tp_size = 1
+        self.tp_rank = 0
+        self.draft_circuit_breaker = TARGET.DraftCircuitBreaker()
+        self.is_rejected = False
+        self.sent_recoveries = []
+
+    def _send_retry_requests(self, reqs, num_draft_tokens):
+        self.sent_recoveries.append((tuple(req.rid for req in reqs), num_draft_tokens))
+
+    def _drain_msg_buffer(self):
+        return []
+
+    def _tp_broadcast_messages(self, messages):
+        return messages or []
+
+    def _store_messages(self, _messages):
+        return False
+
+    def _build_hisparse_decode_batch(self, reqs):
+        return _FakeBatch(reqs)
+
+
+class TestFissionSchedulerHooks(unittest.TestCase):
+    def _recovering_scheduler(self):
+        req = _FakeReq()
+        batch = _FakeBatch([req])
+        scheduler = _FakeScheduler(batch)
+        scheduler._fission_state.ensure(req.rid, req.spec_cnt, 10)
+        result, key = scheduler._fission_state.begin_verify(req.rid)
+        self.assertEqual(result, FISSION.FissionEventResult.APPLIED)
+        batch.fission_keys[req.rid] = key
+        req.spec_cnt = 1
+        batch.fission_outcomes.append(
+            FISSION.FissionOutcomeEvent(
+                key=key,
+                outcome=FISSION.FissionOutcome.RECOVERING,
+                next_spec_cnt=1,
+            )
+        )
+        return scheduler, batch, req
+
+    def test_recovering_row_is_physically_removed_without_releasing_kv_owner(self):
+        scheduler, batch, req = self._recovering_scheduler()
+        original_pool_index = req.req_pool_idx
+
+        scheduler._fission_commit_outcomes_and_park(batch)
+
+        self.assertEqual(batch.reqs, [])
+        self.assertEqual(batch.filter_calls, [((), True)])
+        self.assertIs(scheduler._fission_parked[req.rid], req)
+        self.assertEqual(req.req_pool_idx, original_pool_index)
+        self.assertEqual(scheduler.sent_recoveries, [(("r0",), 4)])
+        self.assertIn((1, 1), scheduler.req_to_draft_token["r0"])
+
+    def test_matching_recovery_reinserts_ready_backup_once(self):
+        scheduler, batch, req = self._recovering_scheduler()
+        scheduler._fission_commit_outcomes_and_park(batch)
+        scheduler.req_to_draft_token["r0"][(1, 1)] = ([7, 8], [0.0, 0.0])
+
+        scheduler._fission_poll_recoveries()
+        scheduler._fission_poll_recoveries()
+
+        self.assertEqual([item.rid for item in scheduler.running_batch.reqs], ["r0"])
+        self.assertEqual(req.cur_drafts, [7, 8])
+        self.assertEqual(req.fission_lane, FISSION.FissionLane.READY_BACKUP.value)
+        self.assertNotIn(req.rid, scheduler._fission_parked)
+
+    def test_stale_recovery_cannot_reinsert(self):
+        scheduler, batch, req = self._recovering_scheduler()
+        scheduler._fission_commit_outcomes_and_park(batch)
+        scheduler.req_to_draft_token["r0"][(1, 0)] = ([7], [0.0])
+
+        scheduler._fission_poll_recoveries()
+
+        self.assertEqual(scheduler.running_batch.reqs, [])
+        self.assertIn(req.rid, scheduler._fission_parked)
+
+    def test_timeout_reinserts_as_one_token_bypass(self):
+        scheduler, batch, req = self._recovering_scheduler()
+        scheduler._fission_commit_outcomes_and_park(batch)
+        scheduler._fission_recovery_timeout_ns = 0
+
+        scheduler._fission_poll_recoveries()
+
+        self.assertEqual([item.rid for item in scheduler.running_batch.reqs], ["r0"])
+        self.assertEqual(req.cur_drafts, [])
+        self.assertEqual(req.fission_lane, FISSION.FissionLane.BYPASS.value)
+        self.assertEqual(
+            scheduler._decide_verify_num_draft_tokens(scheduler.running_batch),
+            1,
+        )
+
+    def test_first_matching_wire_completion_wins(self):
+        req = _FakeReq()
+        req.spec_cnt = 3
+        req.fission_version = 9
+        scheduler = _FakeScheduler(_FakeBatch([req]))
+        scheduler.req_to_draft_token[req.rid][(3, 9)] = None
+        first = _Request(
+            request_id=req.rid,
+            spec_cnt=3,
+            fission_version=9,
+            action=_Action.DRAFT,
+            draft_token_ids=[11],
+            draft_logprobs=[0.1],
+            target_send_time=-1.0,
+        )
+        duplicate = _Request(
+            request_id=req.rid,
+            spec_cnt=3,
+            fission_version=9,
+            action=_Action.DRAFT,
+            draft_token_ids=[99],
+            draft_logprobs=[0.9],
+            target_send_time=-1.0,
+        )
+
+        TARGET.SchedulerSpectreTargetMixin._store_messages(
+            scheduler, [first, duplicate]
+        )
+
+        self.assertEqual(
+            scheduler.req_to_draft_token[req.rid][(3, 9)],
+            ([11], [0.1]),
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
