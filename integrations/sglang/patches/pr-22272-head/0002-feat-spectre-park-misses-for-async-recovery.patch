+    def _fission_commit_outcomes_and_park(self, batch: ScheduleBatch) -> None:
+        outcomes = getattr(batch, "fission_outcomes", ())
+        keys = getattr(batch, "fission_keys", {})
+        if not outcomes or not keys:
+            return
+
+        now_ns = time.monotonic_ns()
+        req_by_rid = {req.rid: req for req in batch.reqs}
+        recovering: List[Req] = []
+
+        for event in outcomes:
+            rid = event.key.request_id
+            req = req_by_rid.get(rid)
+            if req is None or keys.get(rid) != event.key:
+                continue
+
+            record = self._fission_state.get(rid)
+            if record is not None and record.lane in {
+                FissionLane.FINISHED,
+                FissionLane.CANCELLED,
+            }:
+                continue
+
+            event_result, next_key = self._fission_state.post_verify(
+                event.key,
+                event.outcome,
+                event.next_spec_cnt,
+                now_ns,
+            )
+            if event_result != FissionEventResult.APPLIED or next_key is None:
+                continue
+            req.fission_version = next_key.fission_version
+            req.fission_lane = self._fission_state.get(rid).lane.value
+
+            if event.outcome == FissionOutcome.RECOVERING and not req.finished():
+                recovering.append(req)
+                self._fission_parked[rid] = req
+                cache_key = self._spectre_cache_key_for_req(req)
+                self.req_to_draft_token[rid][cache_key] = None
+
+        if recovering:
+            recovering_ids = {id(req) for req in recovering}
+            keep_indices = [
+                index
+                for index, req in enumerate(batch.reqs)
+                if id(req) not in recovering_ids
+            ]
+            # filter_batch only changes the target descriptor. It does not
+            # release req_pool_idx or target KV pages, which remain request-owned.
+            batch.filter_batch(
+                keep_indices=keep_indices,
+                v1_spec_info_filtered=True,
+            )
+            self._send_retry_requests(
+                recovering,
+                max(1, self.server_args.speculative_num_steps),
+            )
+
+    def _fission_poll_recoveries(self) -> None:
+        if self.tp_size == 1 or self.tp_rank == 0:
+            messages = self._drain_msg_buffer()
+        else:
+            messages = None
+        messages = self._tp_broadcast_messages(messages)
+        self._store_messages(messages)
+
+        now_ns = time.monotonic_ns()
+        if self.draft_circuit_breaker.state == DraftCircuitBreaker.OPEN:
+            for rid in tuple(self._fission_parked):
+                self._fission_state.force_bypass(rid, now_ns)
+        else:
+            expired = self._fission_state.expire(
+                now_ns,
+                self._fission_recovery_timeout_ns,
+            )
+            for _ in expired:
+                self.draft_circuit_breaker.record_failure()
+
+        ready: List[Req] = []
+        for rid, req in tuple(self._fission_parked.items()):
+            record = self._fission_state.get(rid)
+            if record is None:
+                continue
+            if record.lane == FissionLane.RECOVERING:
+                cache_key = self._spectre_cache_key_for_req(req)
+                rid_cache = self.req_to_draft_token.get(rid, {})
+                drafts = rid_cache.get(cache_key)
+                if drafts is not None:
+                    del rid_cache[cache_key]
+                    event_result = self._fission_state.complete_recovery(
+                        record.key, now_ns
+                    )
+                    if event_result == FissionEventResult.APPLIED:
+                        # Runtime import avoids a module initialization cycle.
+                        from sglang.srt.speculative.spectre.verifier.spectre_worker import (
+                            _apply_drafts_to_req,
+                        )
+
+                        _apply_drafts_to_req(
+                            req,
+                            verified_token=-1,
+                            drafts=drafts,
+                            skip_d0=False,
+                        )
+                        req.fission_lane = FissionLane.READY_BACKUP.value
+                        ready.append(req)
+                        self.draft_circuit_breaker.record_success()
+            elif record.lane == FissionLane.BYPASS:
+                req.cur_drafts = []
+                req.fission_version = record.key.fission_version
+                req.fission_lane = FissionLane.BYPASS.value
+                ready.append(req)
+
+        for req in ready:
+            self._fission_reinsert(req)
+
+    def _fission_reinsert(self, req: Req) -> None:
+        """Publish a parked request back into a target ScheduleBatch.
+
+        The helper reuses the existing req_pool_idx and therefore the target KV
+        owner. Runtime validation still has to prove that every attention
+        backend accepts this reconstructed descriptor before the feature can be
+        enabled by default.
+        """
+
+        record = self._fission_state.get(req.rid)
+        if record is None or record.lane not in {
+            FissionLane.READY_BACKUP,
+            FissionLane.BYPASS,
+        }:
+            return
+        if req.finished() or getattr(req, "is_retracted", False):
+            self._fission_parked.pop(req.rid, None)
+            return
+        try:
+            new_batch = self._build_hisparse_decode_batch([req])
+            if self.running_batch.is_empty():
+                self.running_batch = new_batch
+            else:
+                self.running_batch.merge_batch(new_batch)
+            self._fission_parked.pop(req.rid, None)
+        except Exception:
+            # Fail closed: leave the request parked and fence this completion.
+            # The timeout/circuit-breaker path cannot publish a descriptor that
+            # failed reconstruction.
+            self._fission_state.force_bypass(req.rid, time.monotonic_ns())
+            logger.exception(
+                "[FissionSpec] failed to reconstruct target descriptor for %s; "
+                "request remains parked",
+                req.rid,
+            )
+
+    def _fission_log_shape(self, batch: ScheduleBatch) -> None:
+        logical_rows = batch.batch_size() + len(self._fission_parked)
+        draft_width = max(1, getattr(batch, "draft_num_tokens", 1))
+        real_verifier_slots = batch.batch_size() * draft_width
+        capture_bs = sorted(getattr(self.server_args, "cuda_graph_bs", ()) or ())
+        graph_rows = batch.batch_size()
+        if capture_bs and graph_rows > 0:
+            index = bisect_left(capture_bs, graph_rows)
+            if index < len(capture_bs):
+                graph_rows = capture_bs[index]
+        graph_bucket_slots = graph_rows * draft_width
+        now_ns = time.monotonic_ns()
+        recovery_ages_ms = [
+            round(record.recovery_age_ns(now_ns) / 1_000_000, 3)
+            for record in self._fission_state.records()
+            if record.lane == FissionLane.RECOVERING
+        ]
+        logger.info(
+            "[FissionSpec] logical_rows=%d real_verifier_slots=%d "
+            "graph_bucket_slots=%d recovery_age_ms=%s",
+            logical_rows,
+            real_verifier_slots,
+            graph_bucket_slots,
+            recovery_ages_ms,
+        )
 
     def _is_self_high_overhead_target(self, batch: ScheduleBatch) -> bool:
         current_bsz = max(batch.batch_size(), self.running_batch.batch_size())
