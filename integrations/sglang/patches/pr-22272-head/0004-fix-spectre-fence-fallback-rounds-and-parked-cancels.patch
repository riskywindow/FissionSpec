--- a/python/sglang/srt/speculative/spectre/fission_state.py
+++ b/python/sglang/srt/speculative/spectre/fission_state.py
@@ -100,6 +100,24 @@ class FissionStateTable:
                 deadline_ns=deadline_ns,
             )
             self._records[request_id] = record
+        elif record.key.spec_cnt != spec_cnt and record.lane in {
+            FissionLane.READY_HIT,
+            FissionLane.READY_BACKUP,
+            FissionLane.BYPASS,
+        }:
+            # A target-only fallback round can advance spec_cnt without a
+            # fission event. Resynchronize before the next speculative launch
+            # and bump the version so replies to the old tuple stay fenced.
+            record = replace(
+                record,
+                key=FissionKey(
+                    request_id,
+                    spec_cnt,
+                    record.key.fission_version + 1,
+                ),
+                ready_since_ns=now_ns,
+            )
+            self._records[request_id] = record
         return record
 
