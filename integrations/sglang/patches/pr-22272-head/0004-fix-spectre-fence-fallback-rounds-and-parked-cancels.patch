         try:
@@ -826,6 +831,24 @@ class SchedulerSpectreTargetMixin:
                 req.rid,
             )
 
+    def _fission_cancel_parked(self, req: Req) -> None:
+        """Fence an async recovery and return the owner for normal abort cleanup."""
+
+        if req.rid not in self._fission_parked:
+            return
+        self._fission_state.cancel(req.rid, req.spec_cnt)
+        record = self._fission_state.get(req.rid)
+        if record is None:
+            return
+        req.fission_version = record.key.fission_version
+        req.fission_lane = FissionLane.CANCELLED.value
+        req.cur_drafts = []
+        self.req_to_draft_token.pop(req.rid, None)
+        # Scheduler.abort_request has already set to_finish. Reinsert one
+        # descriptor so its existing result path releases target KV/pages and
+        # streams the abort, exactly as for an aborted running request.
+        self._fission_reinsert(req, terminal_cleanup=True)
+
     def _fission_log_shape(self, batch: ScheduleBatch) -> None:
         logical_rows = batch.batch_size() + len(self._fission_parked)
         draft_width = max(1, getattr(batch, "draft_num_tokens", 1))
@@ -879,7 +902,10 @@ class SchedulerSpectreTargetMixin:
