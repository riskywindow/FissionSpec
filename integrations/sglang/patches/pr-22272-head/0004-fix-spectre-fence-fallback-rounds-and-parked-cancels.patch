diff --git a/test/srt/test_spectre_fission_scheduler.py b/test/srt/test_spectre_fission_scheduler.py
index 6fc17eab2..ffe3e0d7f 100644
--- a/test/srt/test_spectre_fission_scheduler.py
+++ b/test/srt/test_spectre_fission_scheduler.py
@@ -282,6 +282,21 @@ class TestFissionSchedulerHooks(unittest.TestCase):
             ([11], [0.1]),
         )
 
+    def test_cancel_fences_parked_recovery_and_reinserts_for_cleanup(self):
+        scheduler, batch, req = self._recovering_scheduler()
+        scheduler._fission_commit_outcomes_and_park(batch)
+
+        scheduler._fission_cancel_parked(req)
+
+        self.assertEqual([item.rid for item in scheduler.running_batch.reqs], ["r0"])
+        self.assertEqual(req.fission_lane, FISSION.FissionLane.CANCELLED.value)
+        self.assertNotIn(req.rid, scheduler._fission_parked)
+        self.assertNotIn(req.rid, scheduler.req_to_draft_token)
+        self.assertEqual(
+            scheduler._decide_verify_num_draft_tokens(scheduler.running_batch),
+            1,
+        )
+
 
 if __name__ == "__main__":
     unittest.main()
diff --git a/test/srt/test_spectre_fission_state.py b/test/srt/test_spectre_fission_state.py
index 3d1f11b21..ecd2d7a7b 100644
--- a/test/srt/test_spectre_fission_state.py
+++ b/test/srt/test_spectre_fission_state.py
@@ -133,6 +133,21 @@ class TestFissionStateTable(unittest.TestCase):
         table.remove_terminal("r0")
         self.assertIsNone(table.get("r0"))
 
+    def test_target_only_round_resynchronizes_full_identity(self):
+        table = FissionStateTable()
+        table.ensure("r0", 2, 10)
+        updated = table.ensure("r0", 5, 20)
+        self.assertEqual(updated.key, FissionKey("r0", 5, 1))
+        result, key = table.begin_verify("r0")
+        self.assertEqual(result, FissionEventResult.APPLIED)
+        self.assertEqual(key, FissionKey("r0", 5, 1))
+
+    def test_finish_cannot_overwrite_cancellation(self):
+        table, _ = self._verifying()
+        table.cancel("r0", 8)
+        self.assertEqual(table.finish("r0", 8), FissionEventResult.INVALID)
+        self.assertEqual(table.get("r0").lane, FissionLane.CANCELLED)
+
 
 if __name__ == "__main__":
     unittest.main()
